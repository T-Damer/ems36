---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  taglineAsTitle = false,
  announcement = await Astro.slots.render('announcement'),

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Pages without a title (e.g. documents) can promote the tagline to the page's <h1>.
const TaglineTag = taglineAsTitle && !title ? 'h1' : 'p';
---

<section class="relative md:-mt-[76px] not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20">
      <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
        {announcement && <div class="mb-5 flex justify-center" set:html={announcement} />}
        {
          tagline && (
            <TaglineTag
              class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                set:html={subtitle}
              />
            )
          }
          {
            actions && (
              <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div
        class="intersect-once intercept-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        {
          image && (
            <div class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : typeof image.src === 'string' && image.src.endsWith('.m3u8') ? (
                <div
                  class="hero-video group relative aspect-video overflow-hidden rounded-lg bg-slate-900"
                  data-hero-video
                  data-src={new URL(image.src, Astro.url).href}
                  data-poster="/videos/factory/poster.webp"
                  data-title={image.alt}
                >
                  <img
                    src="/videos/factory/poster-960.webp"
                    srcset="/videos/factory/poster-480.webp 480w, /videos/factory/poster-960.webp 960w, /videos/factory/poster.webp 1920w"
                    sizes="(min-width: 1024px) 1024px, 100vw"
                    width="1920"
                    height="1080"
                    alt={image.alt}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                  <button
                    type="button"
                    class="absolute inset-0 flex items-center justify-center bg-black/10 transition hover:bg-black/20 focus-visible:outline-none"
                    aria-label={`Смотреть видео: ${image.alt}`}
                    data-hero-video-play
                  >
                    <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-slate-900 shadow-xl transition group-hover:scale-110 group-focus-visible:ring-4 group-focus-visible:ring-white/70 md:h-20 md:w-20">
                      <Icon name="tabler:player-play-filled" class="ml-1 h-8 w-8 md:h-9 md:w-9" />
                    </span>
                  </button>
                </div>
              ) : (
                <Image
                  class="mx-auto rounded-md w-full"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  width={1024}
                  height={576}
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Hero video facade: poster + play button; the Mux player (~300 KB of JS) loads only on click.
  const start = async (wrap: HTMLElement) => {
    if (wrap.dataset.loading) return;
    wrap.dataset.loading = 'true';
    const badge = wrap.querySelector('[data-hero-video-play] > span');
    if (badge) badge.innerHTML = '<span class="aw-spinner border-slate-900/20 border-t-slate-900"></span>';
    await import('@mux/mux-player');
    const player = document.createElement('mux-player');
    player.setAttribute('src', wrap.dataset.src ?? '');
    player.setAttribute('poster', wrap.dataset.poster ?? '');
    player.setAttribute('title', wrap.dataset.title ?? '');
    player.setAttribute('stream-type', 'on-demand');
    player.setAttribute('prefer-playback', 'mse');
    player.setAttribute('accent-color', '#0461EF');
    player.setAttribute('playsinline', '');
    player.setAttribute('disable-tracking', '');
    player.setAttribute('autoplay', '');
    player.style.cssText = 'display:block;width:100%;height:100%;aspect-ratio:16/9';
    wrap.replaceChildren(player);
  };

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-hero-video]').forEach((wrap) => {
      wrap.querySelector('[data-hero-video-play]')?.addEventListener('click', () => start(wrap), { once: true });
    });
  });
</script>
