---
import { Icon } from 'astro-icon/components';
import fs from 'node:fs';
import path from 'node:path';
import { getFileNameFromPath } from '~/utils/getFilesFromDir';
import { publicImageSize } from '~/utils/publicImageSize';
import type { ProductImage } from '~/types';

interface Props {
  images: ProductImage[];
  /** Used to build alt text when a file name is not descriptive (e.g. "Одинарный1.jpg"). */
  title?: string;
}

const { images = [], title } = Astro.props;

const altFromPath = (path: string, index: number) => {
  const name = getFileNameFromPath(path).replace(/\.[a-z0-9]+$/i, '');
  return title && /^[\p{L}\s]*\d*$/u.test(name) ? `${title} — фото ${index + 1}` : name;
};

const slides = await Promise.all(
  images.map(async (image, index) => {
    const slide = typeof image === 'string' ? { src: image, alt: altFromPath(image, index) } : image;
    // A 640px "-sm.webp" copy (when present) is shown in the strip; the lightbox opens the full image.
    const thumb = slide.src.replace(/\.webp$/, '-sm.webp');
    const hasThumb =
      thumb !== slide.src && fs.existsSync(path.join(process.cwd(), 'public', decodeURIComponent(thumb)));
    return { ...slide, thumb: hasThumb ? thumb : slide.src, ...(await publicImageSize(slide.src)) };
  })
);
---

<div class="flex items-center gap-x-1 w-full">
  <Icon
    width="32"
    height="32"
    name="tabler:arrow-left"
    class="bg-slate-200 hover:bg-slate-300 active:bg-slate-100 cursor-pointer select-none transition-color rounded-full dark:text-black"
    onclick="const box = document.getElementById('carousel-wrapper'); box.scrollBy({left: -120, behavior: 'smooth'})"
  />
  <div
    id="carousel-wrapper"
    data-lightbox-group
    class="relative flex w-full h-96 snap-x snap-mandatory gap-x-6 overflow-x-scroll no-scrollbar"
  >
    {
      slides.map((slide, index) => (
        <div class="snap-center shrink-0">
          <img
            class="h-80 w-80 shrink-0 rounded-lg object-contain bg-white hover:shadow-md active:shadow-md cursor-zoom-in transition-transform z-20"
            loading={index < 2 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            decoding="async"
            width={600}
            height={600}
            src={slide.thumb}
            alt={slide.alt}
            data-lightbox
            data-lightbox-src={slide.src}
            data-lightbox-width={slide.width}
            data-lightbox-height={slide.height}
          />
        </div>
      ))
    }
  </div>
  <Icon
    width="32"
    height="32"
    name="tabler:arrow-right"
    class="bg-slate-200 hover:bg-slate-300 active:bg-slate-100 select-none cursor-pointer transition-color rounded-full dark:text-black"
    onclick="const box2 = document.getElementById('carousel-wrapper'); box2.scrollBy({left: 120, behavior: 'smooth'})"
  />
</div>
