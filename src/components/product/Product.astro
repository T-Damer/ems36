---
import type { Product as ProductType } from '~/types';
import ToProductLink from './ToProductLink.astro';
import Image from 'astro/components/Image.astro';
import Carousel from '../ui/Carousel.astro';
import VentCarousel from '../widgets/VentCarousel.astro';
import { publicImageSize } from '~/utils/publicImageSize';
import { getFileNameFromPath } from '~/utils/getFilesFromDir';
import { ventProductVideo, videoReelItem, type VentReelItem } from '~/data/ventilation';

interface Props {
  product: ProductType;
}

const { product } = Astro.props;

// Ventilation products use the homepage-style carousel: their photos plus one fitting video.
let reel: VentReelItem[] | undefined;
if (product.type?.slug === 'ventilation' && product.images?.length) {
  reel = await Promise.all(
    product.images.map(async (image): Promise<VentReelItem> => {
      const { src, alt } = typeof image === 'string' ? { src: image, alt: getFileNameFromPath(image) } : image;
      const { width = 960, height = 1280 } = await publicImageSize(src);
      return { kind: 'image', label: alt, image: { src, alt, width, height } };
    })
  );
  const video = ventProductVideo[product.slug];
  if (video) {
    const item = videoReelItem(video.video);
    if (video.position === 'second') reel.splice(1, 0, item);
    else reel.push(item);
  }
}
---

<article class="prose prose-slate dark:prose-invert mx-auto px-4">
  <header class="mb-8">
    <h1 class="mb-2">{product.title}</h1>
    {product.excerpt && <p class="text-xl text-slate-500 dark:text-slate-400">{product.excerpt}</p>}
  </header>

  {
    product.image && (
      <figure class="mb-8">
        <Image
          src={product.image}
          alt={product.title}
          sizes="(max-width: 900px) 400px, 900px"
          widths={[400, 900]}
          width={900}
          height={506}
          loading="eager"
          decoding="async"
        />
      </figure>
    )
  }

  {
    reel ? (
      <div class="not-prose relative left-1/2 mb-8 w-screen max-w-5xl -translate-x-1/2 px-4 sm:px-6">
        <VentCarousel
          items={reel}
          label={product.title}
          sizes="(min-width: 1024px) 280px, (min-width: 768px) 28vw, (min-width: 480px) 42vw, 64vw"
        />
      </div>
    ) : product.images?.length ? (
      <Carousel images={product.images} title={product.title} />
    ) : null
  }

  <div class="mb-8">
    {product.Content ? <product.Content /> : <Fragment set:html={product.content || ''} />}
  </div>

  <ToProductLink />
</article>
