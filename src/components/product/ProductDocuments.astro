---
import { Icon } from 'astro-icon/components';
import type { Product } from '~/types';
import { productDocuments } from '~/data/documents';
import { getPermalink } from '~/utils/permalinks';

interface Props {
  product: Product;
}

const groups = productDocuments(Astro.props.product);
---

{
  groups.length > 0 && (
    <section class="not-prose mb-8" aria-labelledby="product-documents">
      <h2 id="product-documents" class="text-2xl font-bold mb-4">
        Документация
      </h2>
      <div class="flex flex-col gap-y-5">
        {groups.map((group) => (
          <div>
            <h3 class="font-semibold mb-2">
              <a href={getPermalink(group.href)} class="hover:underline">
                {group.title}
              </a>
            </h3>
            <ul class="flex flex-col gap-y-2">
              {group.items.map(({ href, title, regulation }) => (
                <li>
                  <a
                    href={encodeURI(href)}
                    target="_blank"
                    class="flex gap-x-2 items-center leading-tight text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
                  >
                    <Icon name="tabler:file-type-pdf" class="w-5 h-5 shrink-0" />
                    <span>
                      {title}
                      {regulation && (
                        <span class="text-sm text-slate-500 dark:text-slate-400"> · {regulation.split(' — ')[0]}</span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )
}
