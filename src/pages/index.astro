---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import VentilationTeaser from '~/components/widgets/VentilationTeaser.astro';

import siloFieldImage from '~/assets/images/silo-field.png';

const metadata = {
  title: 'ЭлеваторМельСервис',
  description:
    'Производство транспортного технологического оборудования в Воронеже: перекидные клапаны, цепные и ленточные конвейеры, задвижки, нории. Новое направление — воздуховоды и фасонные изделия для вентиляции и аспирации.',
  ignoreTitleTemplate: true,
  rel: 'canonical',
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Написать письмо',
        href: 'mailto:elevatormelservis36@yandex.ru',
        icon: 'tabler:mail',
      },
      { text: 'Узнать больше', href: '#features' },
    ]}
    image={{ src: '/videos/factory/master.m3u8', alt: 'Рабочий процесс' }}
  >
    <Fragment slot="announcement">
      <a
        href="/product/ventilation/"
        class="group inline-flex items-center gap-2 rounded-full bg-white py-1 pl-1 pr-3 text-sm font-medium text-slate-700 shadow-sm ring-1 ring-slate-200 transition hover:shadow-md hover:ring-[#D63A35]/40 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-700"
      >
        <span class="rounded-full bg-[#D63A35] px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-white"
          >Новое!</span
        >
        Вентиляция и аспирация
        <svg
          class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </a>
    </Fragment>

    <Fragment slot="title">
      <span class="block text-3xl sm:text-4xl md:text-5xl font-bold mb-2">
        Элеватор<span class="text-accent dark:text-white highlight">Мель</span>Сервис
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      Компания «ЭлеваторМельСервис» производство транспортного технологического оборудования
    </Fragment>
  </Hero>

  <!-- New: ventilation & aspiration ** -->

  <VentilationTeaser />

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="Почему мы?"
    items={[
      {
        title: 'Экономия времени',
        description: 'Вы экономите свое время, потому что мы используем только передовые технологии',
        icon: 'tabler:clock',
      },
      {
        title: 'Защита потребителя',
        description: 'Вы защищены как потребитель - качество наших услуг соответствует самым современным стандартам',
        icon: 'tabler:shield',
      },
      {
        title: 'Одна точка производства',
        description: 'Весь цикл производства располагается в одном месте',
        icon: 'tabler:asterisk',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Что нужно для получения услуг от нашей компании"
    items={[
      {
        title: 'Шаг 1: <span class="font-medium">Связаться с нами</span>',
        description: 'Написать нам в чате или отправить запрос на электронную почту.',
        icon: 'tabler:message',
      },
      {
        title: 'Шаг 2: <span class="font-medium">Позвоните</span>',
        description: 'Позвоните нам. Мы всегда на связи и рады Вам помочь',
        icon: 'tabler:phone',
      },
      {
        title: 'Шаг 3: <span class="font-medium">Ожидайте ответа</span>',
        description: 'С Вами свяжется наш менеджер, уточнит все детали и вышлет наше предложение',
        icon: 'tabler:alarm',
      },
      {
        title: 'Вот и все!',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Узнайте больше из наших статей"
    information={`Здесь мы храним новости и документацию. Вы можете узнать больше о нашей компании, о наших задумках и начинаниях. Мы также публикуем новости о появлении новых товаров и услуг`}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Клиентов', amount: '250+' },
      { title: 'Года работы', amount: '4' },
      { title: 'Сотрудников', amount: '70' },
      { title: 'Заказов', amount: '3000+' },
      { title: 'Производственных площадей', amount: '2000м²' },
    ]}
  />
</Layout>
