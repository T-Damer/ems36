---
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import YaMaps from '~/components/widgets/YaMaps.astro';
import Hero from '~/components/widgets/Hero.astro';
import { defaultOrgAddress } from '~/utils/openMaps';

const metadata = {
  title: 'Контакты',
  description: 'Связаться с ЭлеваторМельСервис Воронеж',
};
---

<Layout metadata={metadata}>
  <Features2
    title="Свяжитесь с нами!"
    columns={2}
    items={[
      {
        title: 'Телефон',
        description: '+7 (900) 300-63-23',
        callToAction: { href: 'tel:+79003006323', text: 'Позвонить' },
        icon: 'tabler:headset',
      },
      {
        title: 'Почта',
        description: 'elevatormelservis36@yandex.ru',
        callToAction: { href: 'mailto:elevatormelservis36@yandex.ru', text: 'Написать' },
        icon: 'tabler:mail',
      },
      {
        title: 'Местоположение',
        description: defaultOrgAddress,
        callToAction: { onclick: 'openMaps()', text: 'Открыть на картах' },
        icon: 'tabler:map-pin',
        classes: { panel: 'sm:col-span-2' },
      },
      {
        title: 'Телефоны отделов',
        description:
          '<a class="font-medium underline" href="tel:+79507737511">Бухгалтерия</a><br><a class="underline" href="tel:+79507737511">+7 (950) 773 75 11</a><br><br><a class="font-medium underline" href="tel:+79507737347">Отдел снабжения</a><br><a class="underline" href="tel:+79507737347">+7 (950) 773 73 47</a><br><br><a class="font-medium underline" href="tel:+79507737252">Отдел продаж</a><br><a class="underline" href="tel:+79507737252">+7 (950) 773 72 52</a>',
        icon: 'phone-list-bold',
        classes: { panel: 'sm:col-span-2' },
      },
    ]}
  />

  <Hero tagline="Карты">
    <Fragment slot="content">
      <YaMaps />
    </Fragment>
  </Hero>
</Layout>

<script>
  import openMaps from '~/utils/openMaps';

  declare const window: any;
  window.openMaps = openMaps;
</script>
