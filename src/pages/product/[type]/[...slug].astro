---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import Product from '~/components/product/Product.astro';

import { productRobots, getStaticPathsProduct } from '~/utils/product';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsProduct();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { product, redirectTo } = Astro.props as Props & { redirectTo?: string };

if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}

if (!product) {
  return Astro.redirect('/product/');
}

const canonical = new URL(product.permalink, Astro.site);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://ems36.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Продукция', item: 'https://ems36.ru/product/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: product.type?.title || 'Продукция',
      item: new URL(`/product/${product.type?.slug || ''}/`, Astro.site).href,
    },
    { '@type': 'ListItem', position: 4, name: product.title, item: canonical.href },
  ],
};

const metadata = {
  title: product.title,
  description: product.excerpt,
  robots: productRobots,
  openGraph: {
    type: 'article',
  },
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')} />
  <Product product={product} />
</Layout>
