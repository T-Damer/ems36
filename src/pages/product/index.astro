---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import NewBadge from '~/components/ui/NewBadge.astro';
import { getPermalink } from '~/utils/permalinks';
import { placeholderStyle } from '~/utils/placeholder';
import { VENTILATION_PATH, smallVariant, ventCategories, ventSrcset } from '~/data/ventilation';

export const prerender = true;

const coverPlaceholders = await Promise.all(ventCategories.map((category) => placeholderStyle(category.cover.src)));

const metadata = {
  title: 'Продукция',
  description:
    'Каталог оборудования ЭлеваторМельСервис: клапаны, конвейеры, нории, задвижки, завальные ямы, ЗАВ, а также воздуховоды и фасонные изделия для вентиляции и аспирации.',
  robots: {
    index: true,
    follow: true,
  },
};

const links = [
  {
    href: 'valves',
    title: 'Клапаны',
    subTitle: 'Одинарные, двойные, тройные и др.',
  },
  {
    href: 'conveyors',
    title: 'Конвейеры',
    subTitle: 'Винтовые, ленточные и др.',
  },
  {
    href: 'elevators',
    title: 'Элеваторы',
    subTitle: 'Ковшовые, цепные и др.',
  },
  {
    href: 'shutters',
    title: 'Задвижки',
    subTitle: 'Реечные, винтовые и др.',
  },
  {
    href: 'pitfalls',
    title: 'Ямы завальные',
    subTitle: 'Стационарные',
  },
  {
    href: 'zav',
    title: 'Зерноочистительный агрегат',
    subTitle: 'ЗАВ комплекс',
  },
  {
    href: 'other',
    title: 'Прочее',
    subTitle: 'Нории, музы, лестницы и др.',
  },
];
---

<Layout metadata={metadata}>
  <section class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-10 lg:mb-14">Продукция</h1>

    <div class="relative mb-6">
      <NewBadge class="new-corner" />
      <a
        href={VENTILATION_PATH}
        class="group relative grid items-center gap-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-50 to-blue-50 p-6 ring-1 ring-slate-200 transition-shadow hover:shadow-lg md:grid-cols-2 dark:from-slate-800 dark:to-slate-900 dark:ring-slate-700"
      >
        <div class="flex items-start gap-4">
          <div>
            <h2 class="text-xl font-semibold mb-2 sm:text-2xl">Вентиляция и аспирация</h2>
            <p class="text-slate-600 dark:text-slate-400">
              Воздуховоды, отводы, переходы, заглушки и дроссель-клапаны из оцинкованной стали
            </p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-blue-700 dark:text-blue-400">
              Смотреть новинку
              <Icon name="tabler:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
            </span>
          </div>
        </div>
        <div class="grid grid-cols-4 gap-2" aria-hidden="true">
          {
            ventCategories.map((category, index) => (
              <img
                src={smallVariant(category.cover.src)}
                style={coverPlaceholders[index]}
                srcset={ventSrcset(category.cover)}
                sizes="(min-width: 768px) 12vw, 22vw"
                width={category.cover.width}
                height={category.cover.height}
                alt=""
                loading="lazy"
                decoding="async"
                class="aspect-[3/4] w-full rounded-lg object-cover"
              />
            ))
          }
        </div>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        links.map((link) => (
          <a
            href={`/product/${link.href}/`}
            class="block p-6 bg-white dark:bg-slate-800 rounded-lg shadow hover:shadow-lg transition-shadow"
          >
            <h2 class="text-xl font-semibold mb-2">{link.title}</h2>
            <p class="text-slate-600 dark:text-slate-400">{link.subTitle}</p>
          </a>
        ))
      }
    </div>
  </section>

  <a class="inline-flex w-full justify-center items-center gap-x-1 pb-1 underline" href={getPermalink('/')}
    ><Icon name="tabler:arrow-back" />На главную</a
  >
</Layout>
