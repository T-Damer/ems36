---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import NewBadge from '~/components/ui/NewBadge.astro';
import ReelVideo from '~/components/ui/ReelVideo.astro';
import { fetchProducts } from '~/utils/product';
import { placeholderStyle } from '~/utils/placeholder';
import {
  VENTILATION_PATH,
  salesContacts,
  smallVariant,
  ventCategories,
  ventGallery,
  ventOgImage,
  ventSrcset,
  ventVideos,
} from '~/data/ventilation';

const site = Astro.site ?? new URL('https://ems36.ru');
const pageUrl = new URL(VENTILATION_PATH, site).href;

const products = (await fetchProducts()).filter((product) => product.type?.slug === 'ventilation');
const categories = ventCategories.map((category) => {
  const product = products.find((item) => item.slug === category.slug);
  return {
    ...category,
    href: product?.permalink ?? `${VENTILATION_PATH}${category.slug}/`,
    excerpt: product?.excerpt,
    photos: product?.images?.length ?? 0,
  };
});

const videos = ventVideos;

const placeholders = new Map(
  await Promise.all(
    [...ventCategories.map((category) => category.cover.src), ...ventGallery.map((image) => image.src)].map(
      async (src) => [src, await placeholderStyle(src)] as const
    )
  )
);

const metadata = {
  title: 'Вентиляция и аспирация: воздуховоды и фасонные изделия',
  description:
    'Воздуховоды, отводы, переходы, заглушки и дроссель-клапаны из оцинкованной и нержавеющей стали для вентиляции и аспирации. Цена по запросу — Воронеж.',
  robots: { index: true, follow: true },
  openGraph: { images: [ventOgImage] },
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Продукция', item: new URL('/product/', site).href },
      { '@type': 'ListItem', position: 3, name: 'Вентиляция и аспирация', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Воздуховоды и фасонные изделия для вентиляции и аспирации',
    itemListElement: categories.map((category, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: category.title,
      url: new URL(category.href, site).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Производство воздуховодов и фасонных изделий',
    description: 'Как изготавливаются воздуховоды и фасонные изделия для систем вентиляции и аспирации.',
    thumbnailUrl: new URL(videos.production.poster, site).href,
    contentUrl: new URL(videos.production.src, site).href,
    uploadDate: '2026-10-06',
    duration: 'PT33S',
  },
];

const highlights = [
  { icon: 'tabler:box', text: 'Оцинкованная и нержавеющая сталь' },
  { icon: 'tabler:ruler-measure', text: 'Размеры под ваш проект' },
  { icon: 'tabler:building-factory-2', text: 'Собственное производство' },
];
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

  <div class="not-prose">
    <!-- Intro ****************************** -->
    <section class="px-4 pb-12 pt-6 sm:px-6 md:pb-16">
      <nav aria-label="Хлебные крошки" class="mx-auto mb-8 max-w-7xl text-sm text-muted sm:mb-10">
        <ol class="flex flex-wrap items-center gap-1">
          <li><a class="hover:underline" href="/">Главная</a></li>
          <li aria-hidden="true"><Icon name="tabler:chevron-right" class="h-4 w-4" /></li>
          <li><a class="hover:underline" href="/product/">Продукция</a></li>
          <li aria-hidden="true"><Icon name="tabler:chevron-right" class="h-4 w-4" /></li>
          <li aria-current="page" class="text-default dark:text-slate-200">Вентиляция и аспирация</li>
        </ol>
      </nav>

      <div class="relative mx-auto max-w-7xl">
        <NewBadge class="new-corner" />
        <div
          class="relative grid items-center gap-8 rounded-3xl bg-gradient-to-br from-slate-50 via-white to-blue-50 p-5 pt-6 ring-1 ring-slate-200 sm:p-8 md:grid-cols-12 lg:p-10 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800 dark:ring-slate-700"
        >
          <div class="vent-grid pointer-events-none absolute inset-0 rounded-3xl" aria-hidden="true"></div>

          <div class="relative md:col-span-7">
            <h1
              class="font-heading text-4xl font-bold leading-tight tracking-tight text-gray-900 md:text-5xl dark:text-white"
            >
              Производство вентиляции и&nbsp;аспирации
            </h1>
            <p class="mt-5 max-w-2xl text-lg text-muted md:text-xl dark:text-slate-300">
              Изготавливаем воздуховоды прямоугольного и круглого сечения, отводы, переходы, заглушки и дроссель-клапаны
              — для систем вентиляции и аспирации элеваторов, мельниц, складов и производственных цехов.
            </p>

            <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-700 dark:text-slate-300">
              {
                highlights.map((item) => (
                  <li class="flex items-center gap-2">
                    <Icon name={item.icon} class="h-5 w-5 text-primary" />
                    {item.text}
                  </li>
                ))
              }
            </ul>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a class="btn-primary" href={salesContacts.phoneHref}>
                <Icon name="tabler:phone" class="mr-1 -ml-1 h-5 w-5" />
                Узнать цену
              </a>
              <a class="btn-secondary" href="#catalog">
                Смотреть изделия
                <Icon name="tabler:arrow-down" class="ml-1 -mr-1.5 h-5 w-5" />
              </a>
            </div>
          </div>

          <div class="relative md:col-span-5">
            <div
              class="mx-auto aspect-[9/16] h-[min(34rem,calc(100svh-11rem))] min-h-[22rem] overflow-hidden rounded-[2rem] bg-slate-900 shadow-2xl ring-8 ring-white dark:ring-slate-800"
            >
              <ReelVideo
                src={ventVideos.production.srcSmall}
                fullSrc={ventVideos.production.src}
                poster={ventVideos.production.poster}
                title={ventVideos.production.title}
                duration={ventVideos.production.duration}
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Catalog **************************** -->
    <section id="catalog" class="scroll-mt-24 bg-slate-50 py-12 md:py-16 dark:bg-slate-900/60">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <h2 class="font-heading text-3xl font-bold tracking-tight md:text-4xl">Что изготавливаем</h2>
        <p class="mt-3 max-w-2xl text-muted dark:text-slate-400">
          Выберите группу изделий, чтобы посмотреть фотографии и описание.
        </p>

        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            categories.map((category) => (
              <li>
                <a
                  href={category.href}
                  class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-lg focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/50 dark:bg-slate-800 dark:ring-slate-700"
                >
                  <div class="aspect-[4/3] overflow-hidden bg-slate-200 dark:bg-slate-700">
                    <img
                      src={smallVariant(category.cover.src)}
                      style={placeholders.get(category.cover.src)}
                      srcset={ventSrcset(category.cover)}
                      sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 92vw"
                      width={category.cover.width}
                      height={category.cover.height}
                      alt={category.cover.alt}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    <h3 class="text-lg font-semibold leading-snug">{category.title}</h3>
                    {category.excerpt && (
                      <p class="mt-2 flex-1 text-sm text-muted dark:text-slate-400">{category.excerpt}</p>
                    )}
                    <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-blue-700 dark:text-blue-400">
                      {category.photos > 0 ? `Смотреть фото (${category.photos})` : 'Подробнее'}
                      <Icon name="tabler:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                    </span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Ventilation vs aspiration ********** -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <h2 class="font-heading text-3xl font-bold tracking-tight md:text-4xl">Вентиляция и аспирация</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <div class="rounded-2xl p-6 ring-1 ring-slate-200 dark:ring-slate-700">
            <Icon name="tabler:wind" class="h-8 w-8 text-primary" />
            <h3 class="mt-3 text-xl font-semibold">Вентиляция</h3>
            <p class="mt-2 text-muted dark:text-slate-400">
              Обеспечивает воздухообмен в помещении: подаёт свежий воздух и удаляет отработанный. Воздуховоды, отводы и
              переходы формируют трассу, а дроссель-клапаны распределяют расход воздуха по веткам.
            </p>
          </div>
          <div class="rounded-2xl p-6 ring-1 ring-slate-200 dark:ring-slate-700">
            <Icon name="tabler:filter" class="h-8 w-8 text-primary" />
            <h3 class="mt-3 text-xl font-semibold">Аспирация</h3>
            <p class="mt-2 text-muted dark:text-slate-400">
              Удаляет пыль прямо от мест её образования — норий, конвейеров, точек перегрузки зерна. Снижает
              запылённость в цехе и риск взрыва пыли, поэтому особенно важна на элеваторах и мельницах.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Production video ******************* -->
    <section class="bg-slate-900 py-12 text-white md:py-16">
      <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 md:grid-cols-12">
        <div class="md:col-span-7">
          <h2 class="font-heading text-3xl font-bold tracking-tight md:text-4xl">Готовая продукция</h2>
          <p class="mt-4 text-lg text-slate-300">
            Весь цикл — от листа металла до готового изделия — проходит на нашей производственной площадке. На видео —
            готовые воздуховоды и фасонные изделия в цехе.
          </p>
          <ul class="mt-6 space-y-3 text-slate-200">
            <li class="flex gap-3">
              <Icon name="tabler:circle-check" class="h-6 w-6 flex-none text-blue-400" />Прямоугольные и круглые сечения
            </li>
            <li class="flex gap-3">
              <Icon name="tabler:circle-check" class="h-6 w-6 flex-none text-blue-400" />Изготовление по чертежам и
              эскизам заказчика
            </li>
            <li class="flex gap-3">
              <Icon name="tabler:circle-check" class="h-6 w-6 flex-none text-blue-400" />Комплект для всей системы — от
              воздуховодов до клапанов
            </li>
          </ul>
        </div>
        <div class="md:col-span-5">
          <div
            class="mx-auto aspect-[9/16] w-full max-w-[18rem] overflow-hidden rounded-[2rem] bg-black shadow-2xl ring-8 ring-white/10 md:max-w-xs"
          >
            <ReelVideo
              src={ventVideos.result.src}
              poster={ventVideos.result.poster}
              title={ventVideos.result.title}
              duration={ventVideos.result.duration}
              width={540}
              height={960}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Gallery **************************** -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <h2 class="font-heading text-3xl font-bold tracking-tight md:text-4xl">Фото наших изделий</h2>
        <p class="mt-3 text-muted dark:text-slate-400">Нажмите на фото, чтобы увеличить.</p>
        <ul class="mt-8 columns-2 gap-3 sm:gap-4 md:columns-3 lg:columns-4" data-lightbox-group>
          {
            ventGallery.map((image) => (
              <li class="mb-3 break-inside-avoid sm:mb-4">
                <img
                  src={smallVariant(image.src)}
                  style={placeholders.get(image.src)}
                  srcset={ventSrcset(image)}
                  sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 46vw"
                  width={image.width}
                  height={image.height}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  data-lightbox
                  data-lightbox-src={image.src}
                  data-lightbox-width={image.width}
                  data-lightbox-height={image.height}
                  class="h-auto w-full cursor-zoom-in rounded-xl bg-slate-200 dark:bg-slate-700"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Price CTA ************************** -->
    <section class="px-4 pb-16 sm:px-6">
      <div
        class="relative mx-auto max-w-7xl overflow-hidden rounded-3xl bg-primary px-6 py-10 text-white sm:px-10 md:py-12"
      >
        <div class="relative grid items-center gap-8 md:grid-cols-2">
          <div>
            <h2 class="font-heading text-3xl font-bold tracking-tight">Цена — по запросу</h2>
            <p class="mt-3 text-lg text-white/90">
              Стоимость зависит от сечения, количества и комплектации. Позвоните или напишите в отдел продаж —
              рассчитаем заказ под ваш проект.
            </p>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2">
            <li class="sm:col-span-2">
              <a
                href={salesContacts.phoneHref}
                class="flex items-center gap-3 rounded-2xl bg-white px-5 py-4 font-semibold text-blue-700 shadow-lg transition hover:bg-blue-50"
              >
                <Icon name="tabler:phone" class="h-6 w-6 flex-none" />
                <span>
                  <span class="block text-xs font-medium uppercase tracking-wider text-slate-500">Отдел продаж</span>
                  <span class="text-lg">{salesContacts.phone}</span>
                </span>
              </a>
            </li>
            <li>
              <a
                href={salesContacts.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 rounded-2xl bg-blue-950/25 px-5 py-4 font-medium ring-1 ring-white/30 transition hover:bg-blue-950/40"
              >
                <Icon name="tabler:brand-whatsapp" class="h-6 w-6 flex-none" />WhatsApp
              </a>
            </li>
            <li>
              <a
                href={`mailto:${salesContacts.email}?subject=${encodeURIComponent('Запрос цены: вентиляция и аспирация')}`}
                class="flex items-center gap-3 rounded-2xl bg-blue-950/25 px-5 py-4 font-medium ring-1 ring-white/30 transition hover:bg-blue-950/40"
              >
                <Icon name="tabler:mail" class="h-6 w-6 flex-none" />Написать письмо
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .vent-grid {
    background-image:
      linear-gradient(to right, rgb(1 97 239 / 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(1 97 239 / 0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at 70% 40%, black 15%, transparent 70%);
  }
</style>
