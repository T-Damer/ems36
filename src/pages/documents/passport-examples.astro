---
import FileList from '~/components/widgets/FileList.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { documentsOfKind } from '~/data/documents';

const metadata = {
  title: 'Образцы паспортов',
  description:
    'Образцы паспортов на оборудование ЭлеваторМельСервис: задвижки, клапаны, конвейеры, элеваторы, фильтры — скачать PDF.',
};
---

<Layout metadata={metadata}>
  <Hero tagline={metadata.title} taglineAsTitle>
    <Fragment slot="content">
      <FileList files={documentsOfKind('passport')} />
    </Fragment>
  </Hero>
</Layout>
