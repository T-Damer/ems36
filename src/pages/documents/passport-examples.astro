---
import FileList from '~/components/widgets/FileList.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Образцы паспортов',
  description:
    'Образцы паспортов на оборудование ЭлеваторМельСервис: клапаны, конвейеры, нории, задвижки — скачать PDF.',
};
---

<Layout metadata={metadata}>
  <Hero tagline={metadata.title} taglineAsTitle>
    <Fragment slot="content">
      <FileList dir="files/passports" />
    </Fragment>
  </Hero>
</Layout>
