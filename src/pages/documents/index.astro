---
import { Icon } from 'astro-icon/components';
import FileList from '~/components/widgets/FileList.astro';
import Layout from '~/layouts/PageLayout.astro';
import { type DocumentKind, documentKinds, documentsOfKind, permitsByRegulation } from '~/data/documents';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

const metadata = {
  title: 'Документация',
  description:
    'Документация на оборудование ЭлеваторМельСервис: образцы паспортов, руководства по эксплуатации, сертификаты и декларации ЕАЭС — скачать PDF.',
  robots: {
    index: true,
    follow: true,
  },
};

const sections = (Object.keys(documentKinds) as DocumentKind[]).map((kind) => ({
  kind,
  ...documentKinds[kind],
  href: getPermalink(documentKinds[kind].href),
  count: documentsOfKind(kind).length,
}));
---

<Layout metadata={metadata}>
  <section class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-10 lg:mb-14">Документация</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {
        sections.map((section) => (
          <a
            href={`#${section.kind}`}
            class="block p-6 bg-white dark:bg-slate-800 rounded-lg shadow hover:shadow-lg transition-shadow"
          >
            <h2 class="text-xl font-semibold mb-2">{section.title}</h2>
            <p class="text-slate-600 dark:text-slate-400">{section.subtitle}</p>
            <p class="mt-3 text-sm font-medium text-blue-700 dark:text-blue-400">Документов: {section.count}</p>
          </a>
        ))
      }
    </div>

    {
      sections.map((section) => (
        <section id={section.kind} class="scroll-mt-24 mb-12">
          <div class="max-w-4xl mx-auto mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-2xl font-bold">{section.title}</h2>
            <a
              href={section.href}
              class="inline-flex items-center gap-1 text-sm font-medium text-blue-700 hover:underline dark:text-blue-400"
            >
              Открыть раздел
              <Icon name="tabler:arrow-right" class="h-4 w-4" />
            </a>
          </div>
          {section.kind === 'permit' ? (
            <div class="flex flex-col gap-y-6">
              {permitsByRegulation().map(({ regulation, items }) => (
                <FileList title={regulation} files={items} />
              ))}
            </div>
          ) : (
            <FileList files={documentsOfKind(section.kind)} />
          )}
        </section>
      ))
    }
  </section>
</Layout>
