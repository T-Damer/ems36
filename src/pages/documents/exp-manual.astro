---
import FileList from '~/components/widgets/FileList.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { documentsOfKind } from '~/data/documents';

const metadata = {
  title: 'Руководство по эксплуатации',
  description:
    'Руководства по эксплуатации оборудования ЭлеваторМельСервис: конвейеры ленточные и цепные, элеваторы ковшовые, фильтры — скачать PDF.',
};
---

<Layout metadata={metadata}>
  <Hero tagline={metadata.title} taglineAsTitle>
    <Fragment slot="content">
      <FileList files={documentsOfKind('manual')} />
    </Fragment>
  </Hero>
</Layout>
