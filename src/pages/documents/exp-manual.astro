---
import FileList from '~/components/widgets/FileList.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Руководство по эксплуатации',
  description:
    'Руководства по эксплуатации оборудования ЭлеваторМельСервис: клапаны, конвейеры, нории, задвижки — скачать PDF.',
};
---

<Layout metadata={metadata}>
  <Hero tagline={metadata.title} taglineAsTitle>
    <Fragment slot="content">
      <FileList dir="files/exp-manual" />
    </Fragment>
  </Hero>
</Layout>
